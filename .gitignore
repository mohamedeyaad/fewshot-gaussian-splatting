# ---------------------------------------------------------------------------
# Environment (7.5 GB) - rebuild with the commands in README.md
# ---------------------------------------------------------------------------
venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Upstream 3DGS clone (391 MB). Not vendored: it is someone else's repository
# and our two edits live in patches/ instead.
# ---------------------------------------------------------------------------
gaussian-splatting/

# ---------------------------------------------------------------------------
# Dataset (1.4 GB) - Tanks & Temples "truck", downloaded, not authored here
# ---------------------------------------------------------------------------
data/

# ---------------------------------------------------------------------------
# Training outputs (6.7 GB): checkpoints and rendered PNGs.
# The results.json files ARE kept - they are the raw experimental record and
# every number in the report is read back out of them.
# ---------------------------------------------------------------------------
runs/**
!runs/
!runs/*/
!runs/*/results.json
runs_noise/**
!runs_noise/
!runs_noise/*/
!runs_noise/*/results.json

# ---------------------------------------------------------------------------
# Assembled scene directories: symlink farms with absolute paths, so they would
# be broken on any other machine. Regenerate with src/build_scene.py.
# ---------------------------------------------------------------------------
scenes/

# Scratch
*.log
.DS_Store

# ---------------------------------------------------------------------------
# Regenerated .ply point clouds for the SuperSplat viewer (~1.3 GB). Not the
# experimental record - runs/*/results.json is. Rebuild: src/run_viewer_models.sh
# ---------------------------------------------------------------------------
viewer/

# ---------------------------------------------------------------------------
# Generated synthetic views (~200 MB). Never tracked, now said so explicitly:
# an earlier 'git add -A' swept in files nobody meant to commit. Regenerate
# with src/gen_<strategy>.py - the manifests and seeds are committed, so the
# selection is reproducible even though diffusion output is not bit-exact.
# ---------------------------------------------------------------------------
synthetic/

# ---------------------------------------------------------------------------
# Isolated-object experiment (lego / legoc), set aside. Moved here rather than
# deleted: it is ~6h20m of compute, and the results.json files remain in git
# history at commit aa17381 if it is ever wanted back.
# ---------------------------------------------------------------------------
archive_isolated/

# 30,000-iteration convergence check, isolated from runs/ so it cannot
# collide with the 7,000-iteration run of the same condition.
runs_30k/**
!runs_30k/
!runs_30k/*/
!runs_30k/*/results.json

# 15,000-iteration point on the training-length axis, isolated for the same
# reason as runs_30k/.
runs_15k/**
!runs_15k/
!runs_15k/*/
!runs_15k/*/results.json

logs/
